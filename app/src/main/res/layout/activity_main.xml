<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/backgroundcolor"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/toolbarcolor"
        app:title="minersworldcoin Android Miner"
        app:titleTextColor="?attr/textcolor" />

    <!-- The form scrolls independently of the status and log panels below. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="?attr/cardbkgcolor">

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:lineSpacingExtra="2dp"
                    app:fontFamily="@font/ubuntu_regular"
                    android:text="@string/textView1"
                    android:textColor="?attr/textcolor"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pool preset"
                android:textColor="?attr/textcolor"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/poolPresetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="?attr/textcolor" />

            <Button
                android:id="@+id/savePoolButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Save current pool"
                android:textColor="?attr/textcolor"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/editText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/hint1"
                android:inputType="textUri"
                android:textColor="?attr/textcolor"
                android:textColorHint="?attr/textcolor"
                app:backgroundTint="?attr/textcolor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editText2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint2"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="?attr/textcolor"
                android:textColorHint="?attr/textcolor"
                app:backgroundTint="?attr/textcolor"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/editText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint3"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="?attr/textcolor"
                android:textColorHint="?attr/textcolor"
                app:backgroundTint="?attr/textcolor"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/threadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thread Count"
                android:textColor="?attr/textcolor"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/threadSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="?attr/textcolor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Algorithm"
                android:textColor="?attr/textcolor"
                android:paddingTop="10dp"
                android:paddingBottom="4dp"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:backgroundTint="?attr/textcolor" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/cardbkgcolor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saved setups"
                        android:textColor="?attr/textcolor"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/setupSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:backgroundTint="?attr/textcolor" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/saveSetupButton"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Save"
                            android:textColor="?attr/textcolor"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/deleteSetupButton"
                            style="?android:attr/buttonStyleSmall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Delete"
                            android:textColor="?attr/textcolor"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/roundshapebutton"
                android:text="Start"
                android:textColor="?attr/textcolor" />

            <Switch
                android:id="@+id/darkmode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Dark Mode"
                android:textColor="?attr/textcolor"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/sessionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:padding="6dp"
        android:background="?attr/cardbkgcolor"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Mining: stopped"
        android:textColor="?attr/textcolor"
        android:textSize="11sp" />

    <!-- Dedicated, always-visible log box with its own scrolling. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:background="@drawable/log_box_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clearLogsButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear"
                android:textColor="?attr/textcolor"
                android:textSize="11sp" />

            <Button
                android:id="@+id/copyLogsButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy"
                android:textColor="?attr/textcolor"
                android:textSize="11sp" />

            <Button
                android:id="@+id/shareLogsButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share"
                android:textColor="?attr/textcolor"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top"
            android:scrollbars="vertical"
            android:textColor="?attr/textcolor"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
