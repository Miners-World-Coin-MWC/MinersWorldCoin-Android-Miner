<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?attr/backgroundcolor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingstoolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/toolbarcolor"
        app:title="Settings"
        app:titleTextColor="?attr/textcolor"
        android:theme="@style/ToolBarTheme"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/version_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/textcolor"
                android:textSize="14sp"
                android:text="Version" />

            <Switch
                android:id="@+id/notificationsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mining notifications"
                android:textColor="?attr/textcolor"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Android requires a notification while mining. Turning this off leaves a quiet, static notification but stops hashrate and share updates."
                android:textColor="?attr/textcolor"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/donationsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Support development (5 min per hour)"
                android:textColor="?attr/textcolor"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="After 60 minutes of mining, your hashrate is directed to the project address for 5 minutes, then automatically returns to your address."
                android:textColor="?attr/textcolor"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/batteryGuardSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Battery &amp; heat protection"
                android:textColor="?attr/textcolor"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Automatically pauses mining when the battery drops to 15% (while unplugged) or the device gets too hot."
                android:textColor="?attr/textcolor"
                android:textSize="12sp" />

            <Button
                android:id="@+id/batterySettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/roundshapebutton"
                android:text="Battery optimization settings"
                android:textColor="?attr/textcolor" />

            <TextView
                android:id="@+id/battery_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/textcolor"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
